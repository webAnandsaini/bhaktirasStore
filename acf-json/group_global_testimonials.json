{
    "key": "group_global_testimonials",
    "title": "Global Testimonials & Reviews",
    "fields": [
        {
            "key": "field_global_testi_title",
            "label": "Section Title",
            "name": "testimonials_title",
            "type": "text",
            "required": 0,
            "placeholder": "What our clients Say",
            "wrapper": {
                "width": "100"
            }
        },
        {
            "key": "field_global_testi_items",
            "label": "Customer Testimonial Cards (Figma 1:1)",
            "name": "testimonials_items",
            "type": "repeater",
            "instructions": "Add customer photo testimonial cards. Reusable across Homepage, Product Detail Pages, and all templates.",
            "required": 0,
            "layout": "block",
            "button_label": "Add Testimonial Card",
            "sub_fields": [
                {
                    "key": "field_gt_photo",
                    "label": "Customer / Devotee Photo",
                    "name": "customer_photo",
                    "type": "image",
                    "required": 1,
                    "return_format": "array",
                    "wrapper": {
                        "width": "33"
                    }
                },
                {
                    "key": "field_gt_author",
                    "label": "Devotee / Customer Name",
                    "name": "author_name",
                    "type": "text",
                    "required": 0,
                    "placeholder": "Reema R.",
                    "wrapper": {
                        "width": "33"
                    }
                },
                {
                    "key": "field_gt_rating",
                    "label": "Star Rating (1 to 5)",
                    "name": "rating",
                    "type": "number",
                    "required": 0,
                    "placeholder": "5",
                    "min": 1,
                    "max": 5,
                    "wrapper": {
                        "width": "34"
                    }
                },
                {
                    "key": "field_gt_prod_img",
                    "label": "Small Product Thumbnail (Optional)",
                    "name": "product_thumbnail",
                    "type": "image",
                    "required": 0,
                    "return_format": "array",
                    "wrapper": {
                        "width": "33"
                    }
                },
                {
                    "key": "field_gt_prod_title",
                    "label": "Product Name / Mention",
                    "name": "product_title",
                    "type": "text",
                    "required": 0,
                    "placeholder": "Lord Venkateswara Swamy Acrylic Wall art",
                    "wrapper": {
                        "width": "33"
                    }
                },
                {
                    "key": "field_gt_review",
                    "label": "Review Quote (Optional)",
                    "name": "review_text",
                    "type": "textarea",
                    "required": 0,
                    "rows": 2,
                    "wrapper": {
                        "width": "34"
                    }
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "options_page",
                "operator": "==",
                "value": "global-testimonials"
            }
        ],
        [
            {
                "param": "options_page",
                "operator": "==",
                "value": "theme-general-settings"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "description": "Global Testimonials matching Figma 1:1"
}