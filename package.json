{
  "name": "dharmgyan",
  "version": "1.0.0",
  "description": "dharmgyan WordPress Theme with Tailwind CSS 4.0 and Vite",
  "type": "module",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:server": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "watch": "node ./watch.js",
    "watch:vite": "vite build --watch --mode development --config vite.config.js",
    "watch:prod": "vite build --watch --mode production --config vite.config.js",
    "watch:simple": "vite build && fswatch -o src/ | xargs -n1 -I{} vite build",
    "watch:manual": "while true; do vite build; sleep 2; done",
    "clean": "rm -rf assets/css/* assets/js/*",
    "build:prod": "vite build --mode production"
  },
  "keywords": [
    "wordpress",
    "theme",
    "tailwindcss",
    "vite"
  ],
  "author": "Sandeep Sharma",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "swiper": "^12.0.3"
  }
}
